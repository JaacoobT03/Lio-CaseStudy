# Copy to .env before running `docker compose up`

# Required for PDF data extraction (the rest of the app works without it)
OPENAI_API_KEY=your_openai_api_key

# Optional overrides
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=low   # leave empty for models without reasoning, e.g. gpt-4o-mini
# JWT_SECRET=generate-with-openssl-rand-hex-32
